# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# ──────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
# Claude API (agente WhatsApp)
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────
# Meta WhatsApp Cloud API
# ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ──────────────────────────────────────────────
# OpenAI (Whisper — transcripción de audios)
# ──────────────────────────────────────────────
OPENAI_API_KEY=

# ──────────────────────────────────────────────
# Auth OTP (login de dos factores)
# ──────────────────────────────────────────────
# Secreto para cifrar el estado pendiente del OTP (AES-256-GCM)
# Generar con: openssl rand -base64 32
AUTH_OTP_SECRET=

# ──────────────────────────────────────────────
# Email transaccional (OTP en producción)
# ──────────────────────────────────────────────
# En desarrollo el OTP se imprime en la consola del servidor
RESEND_API_KEY=
EMAIL_FROM_NAME=NEVO-POS
EMAIL_FROM_ADDRESS=no-reply@nevo-pos.app

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TENANT_SLUG=mercurio-barberia
